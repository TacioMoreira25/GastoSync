# ==============================================================================
# GastoSync Monorepo - .gitignore
# ==============================================================================

# Operating System & IDEs
.DS_Store
Thumbs.db
*.swp
*.bak
*~
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Environment Variables & Secrets (Groq API, Tokens, MASVS compliance)
.env
.env.*
!.env.example

# Local Databases (Drift / SQLite)
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.db-journal

# ------------------------------------------------------------------------------
# Flutter / Dart (gastosync_app)
# ------------------------------------------------------------------------------
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/
**/coverage/
**/doc/api/
**/.widget_preview/

# Android build artifacts
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/.gradle/
**/android/captures/
**/android/local.properties

# iOS build artifacts
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec


# ------------------------------------------------------------------------------
# Python Backend (gastosync_agent)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv/

# Spec Kit Machine-local state
.specify/feature.json

