# ==============================================================================
# GastoSync API (Go) - Variáveis de Ambiente (EXEMPLO - SEM DADOS SENSÍVEIS)
# Copie este arquivo para .env apenas em ambiente de desenvolvimento local:
#   cp .env.example .env
# NUNCA faça commit do arquivo .env real!
# ==============================================================================

# Porta do servidor HTTP (O Render injeta PORT automaticamente em produção)
PORT=8080

# Ambiente de execução: development | production
APP_ENV=development

# String de conexão do Neon Serverless PostgreSQL (SEMPRE com sslmode=require)
# Obtida no painel do Neon (https://console.neon.tech)
DATABASE_URL=postgresql://usuario:senha_secreta@ep-exemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Chave secreta para assinatura e validação de tokens JWT (mínimo 32 caracteres aleatórios)
# Gere uma chave segura no terminal com: openssl rand -hex 32
JWT_SECRET=substitua_por_uma_chave_hexadecimal_de_64_caracteres_gerada_via_openssl

# Tempo de expiração do token JWT em horas (ex: 168h = 7 dias)
JWT_EXPIRATION_HOURS=168

# Origens permitidas no CORS (separadas por vírgula)
# Em produção, inclua o domínio do seu Cloudflare Pages (ex: https://gastosync.pages.dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://gastosync.pages.dev
