# ==============================================================================
# GastoSync Core API - Environment Configuration Template
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# HTTP server listening port
PORT=8080

# Execution environment (development | staging | production)
# Set APP_ENV=production on Render so dev_preview_code is never returned
APP_ENV=development

# PostgreSQL connection URI (TLS required: sslmode=require)
DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# HMAC-SHA256 secret key used to sign and verify JWT tokens (minimum 32 bytes recommended)
JWT_SECRET=replace_with_a_64_char_hex_secret_generated_via_openssl_rand_hex_32

# Token validity duration in hours (default: 168 = 7 days)
JWT_EXPIRATION_HOURS=168

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ==============================================================================
# Email Dispatch Configuration (Password Recovery 6-digit OTP)
# ==============================================================================

# Option A (Recommended for Render Free Tier - HTTPS port 443, never blocked):
# Brevo (300 free emails/day, works with your personal Gmail as SENDER_EMAIL)
BREVO_API_KEY=
SENDER_EMAIL=seuemail@gmail.com
SENDER_NAME=GastoSync Seguranca

# Option B (Alternative for Render Free Tier - HTTPS port 443):
# Resend (3,000 free emails/month)
RESEND_API_KEY=

# Option C (Traditional SMTP - Local Mailpit or Gmail App Password on VPS):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=GastoSync Seguranca <seuemail@gmail.com>
